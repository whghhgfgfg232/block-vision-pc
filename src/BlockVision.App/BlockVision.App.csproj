<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BlockVisionPC</AssemblyName>
    <RootNamespace>BlockVision.App</RootNamespace>
    <ApplicationIcon>Assets\shield.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Authors>BlockVision Team</Authors>
    <Description>Block Vision PC - Система защиты экрана с активацией для любых приложений</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BlockVision.Core\BlockVision.Core.csproj" />
    <ProjectReference Include="..\BlockVision.SDK\BlockVision.SDK.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="1.1.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\**\*.*" />
  </ItemGroup>

</Project>
