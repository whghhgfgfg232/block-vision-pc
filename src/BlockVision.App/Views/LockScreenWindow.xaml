<Window x:Class="BlockVision.App.Views.LockScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Block Vision PC - Заблокировано"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        Topmost="True"
        ShowInTaskbar="False"
        Background="Transparent"
        AllowsTransparency="True"
        KeyDown="Window_KeyDown"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <Window.Resources>
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.5"/>
        </Storyboard>
        <Storyboard x:Key="Shake">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)">
                <EasingDoubleKeyFrame KeyTime="0:0:0.0" Value="0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.05" Value="-10"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.1" Value="10"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.15" Value="-10"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="10"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.25" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </Window.Resources>

    <Grid>
        <!-- Фон -->
        <Grid x:Name="BackgroundGrid">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0f0c29" Offset="0"/>
                    <GradientStop Color="#302b63" Offset="0.5"/>
                    <GradientStop Color="#24243e" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>

            <!-- Blur + частицы (имитация) -->
            <Rectangle Fill="#AA000000" x:Name="BlurOverlay"/>
            
            <!-- Эффект сетки / сканлайнов -->
            <Canvas x:Name="ParticlesCanvas" Opacity="0.3"/>
        </Grid>

        <!-- Основной контент по центру -->
        <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Width="480">
            <Border Background="#1E1E2F" CornerRadius="16" Padding="30" BorderBrush="#3D3D5C" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="#6C5CE7" BlurRadius="30" ShadowDepth="0" Opacity="0.4"/>
                </Border.Effect>

                <StackPanel x:Name="MainPanel">
                    <StackPanel.RenderTransform>
                        <TranslateTransform/>
                    </StackPanel.RenderTransform>

                    <!-- Лого / иконка -->
                    <StackPanel HorizontalAlignment="Center" Margin="0,0,0,20">
                        <Border Width="80" Height="80" CornerRadius="40" Background="#6C5CE7" HorizontalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect Color="#6C5CE7" BlurRadius="20" ShadowDepth="0" Opacity="0.7"/>
                            </Border.Effect>
                            <TextBlock Text="🛡️" FontSize="40" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="WelcomeText" Text="Система защищена Block Vision PC" 
                                   Foreground="White" FontSize="18" FontWeight="Bold" 
                                   HorizontalAlignment="Center" Margin="0,15,0,5" TextWrapping="Wrap" TextAlignment="Center"/>
                        <TextBlock x:Name="LockReasonText" Text="Доступ заблокирован" 
                                   Foreground="#AAAAAA" FontSize="13" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>

                    <!-- Время -->
                    <StackPanel x:Name="ClockPanel" HorizontalAlignment="Center" Margin="0,0,0,25">
                        <TextBlock x:Name="TimeText" Text="12:00" FontSize="48" FontWeight="Light" Foreground="White" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="DateText" Text="16 июля 2026" FontSize="14" Foreground="#888888" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Поле пароля -->
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Пароль" Foreground="#CCCCCC" FontSize="12" Margin="0,0,0,5"/>
                        <Grid>
                            <TextBox x:Name="PasswordBox" 
                                     Style="{StaticResource ModernTextBox}" 
                                     Height="46"
                                     VerticalContentAlignment="Center"
                                     KeyDown="PasswordBox_KeyDown"
                                     GotFocus="PasswordBox_GotFocus"
                                     Background="#2D2D44"
                                     Foreground="White"
                                     BorderBrush="#3D3D5C"
                                     CaretBrush="White"/>
                            <TextBlock x:Name="PasswordPlaceholder" Text="Введите пароль" 
                                       Foreground="#666666" Margin="14,0,0,0" 
                                       VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Grid>
                    </StackPanel>

                    <!-- Поле ключа активации -->
                    <StackPanel Margin="0,10,0,10">
                        <TextBlock Text="Ключ активации" Foreground="#CCCCCC" FontSize="12" Margin="0,0,0,5"/>
                        <Grid>
                            <TextBox x:Name="ActivationKeyBox"
                                     Style="{StaticResource ModernTextBox}"
                                     Height="46"
                                     VerticalContentAlignment="Center"
                                     KeyDown="ActivationKeyBox_KeyDown"
                                     FontFamily="Consolas"
                                     Background="#2D2D44"
                                     Foreground="White"
                                     BorderBrush="#3D3D5C"
                                     CaretBrush="White"/>
                            <TextBlock x:Name="KeyPlaceholder" Text="BVPC-XXXX-XXXX-XXXX-XXXX" 
                                       Foreground="#444466" Margin="14,0,0,0" 
                                       VerticalAlignment="Center" IsHitTestVisible="False" FontFamily="Consolas"/>
                        </Grid>
                    </StackPanel>

                    <!-- Кнопка разблокировки -->
                    <Button x:Name="UnlockButton" Content="Разблокировать" 
                            Style="{StaticResource NeonButton}" 
                            Height="48" Margin="0,15,0,10"
                            Click="UnlockButton_Click"/>

                    <!-- Сообщения -->
                    <Border x:Name="MessageBorder" Background="#33FF7675" CornerRadius="8" Padding="12" Margin="0,10,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="MessageText" Foreground="#FF7675" TextWrapping="Wrap" FontSize="13"/>
                    </Border>

                    <Border x:Name="SuccessBorder" Background="#3300CEC9" CornerRadius="8" Padding="12" Margin="0,10,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="SuccessText" Foreground="#00CEC9" TextWrapping="Wrap" FontSize="13"/>
                    </Border>

                    <!-- Попытки -->
                    <StackPanel x:Name="AttemptsPanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0" Visibility="Collapsed">
                        <TextBlock Text="⚠️" Margin="0,0,5,0"/>
                        <TextBlock x:Name="AttemptsText" Foreground="#FF7675" FontSize="12"/>
                    </StackPanel>

                    <!-- Информация о триггере -->
                    <Border Background="#1AFFFFFF" CornerRadius="8" Padding="10" Margin="0,15,0,0" x:Name="ThreatInfoBorder" Visibility="Collapsed">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🚨" Margin="0,0,5,0"/>
                                <TextBlock Text="Обнаружена угроза:" Foreground="#FF7675" FontWeight="Bold" FontSize="12"/>
                            </StackPanel>
                            <TextBlock x:Name="ThreatDetailsText" Foreground="#CCCCCC" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Нижняя панель -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                        <TextBlock Text="🔒" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="HardwareIdText" Text="ID: XXXX" Foreground="#555577" FontSize="10" VerticalAlignment="Center"/>
                        <TextBlock Text=" • " Foreground="#555577" FontSize="10" VerticalAlignment="Center"/>
                        <TextBlock Text="Настройки" Foreground="#6C5CE7" FontSize="10" Cursor="Hand" MouseDown="Settings_MouseDown" TextDecorations="Underline"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Defender баннер сверху -->
        <Border x:Name="DefenderBanner" Background="#CCFF7675" CornerRadius="0,0,12,12" 
                HorizontalAlignment="Center" VerticalAlignment="Top" Padding="20,12" 
                Margin="0,0,0,0" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🛡️ Microsoft Defender:" FontWeight="Bold" Foreground="White" Margin="0,0,10,0"/>
                <TextBlock x:Name="DefenderBannerText" Text="Обнаружена угроза" Foreground="White"/>
            </StackPanel>
        </Border>

        <!-- Загрузка -->
        <Grid x:Name="LoadingGrid" Background="#AA000000" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Проверка..." Foreground="White" FontSize="16" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
